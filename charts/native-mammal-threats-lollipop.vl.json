          },
          {
            "field": "percent",
            "type": "quantitative",
            "title": "Share of 138 species (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 17,
        "font": "DM Sans",
        "fontSize": 12.6,
        "fontWeight": 800,
        "color": "#24375C"
      },
      "encoding": {
        "text": {
          "field": "percent_label",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "paper_label",
            "type": "nominal",
            "title": "Threat factor"
          },
          {
            "field": "species",
            "type": "quantitative",
            "title": "Species at risk",
            "format": ".0f"
          },
          {
            "field": "percent",
            "type": "quantitative",
            "title": "Share of 138 species (%)",
            "format": ".1f"
          }
        ]
      }
    }
