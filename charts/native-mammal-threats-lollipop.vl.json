      "axis": {
        "title": null,
        "labelColor": "#24375C",
        "labelFont": "DM Sans",
        "labelFontSize": 10.5,
        "labelFontWeight": 600,
        "labelLimit": 125,
        "labelPadding": 7,
        "domain": true,
        "ticks": false,
        "domainColor": "#9AAECD",
        "domainWidth": 1.65,
        "labelExpr": "split(datum.label, ' / ')",
