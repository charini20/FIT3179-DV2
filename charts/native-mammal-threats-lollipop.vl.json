    },
    "x": {
      "field": "percent",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "title": null,
        "titleColor": "#24375C",
        "titleFont": "DM Sans",
        "titleFontSize": 10.5,
        "titleFontWeight": 600,
        "titlePadding": 12,
        "labelColor": "#61738D",
        "labelFont": "DM Sans",
        "labelFontSize": 10.5,
        "labelPadding": 10,
        "values": [
          0,
          20,
          40,
          60,
          80,
          100
        ],
        "labelExpr": "datum.value + '%'",
        "grid": false,
        "gridColor": "#E8EDF6",
        "gridWidth": 1,
        "domain": true,
        "domainColor": "#9AAECD",
        "domainWidth": 1.4,
        "tickColor": "#B8C4D9",
        "tickWidth": 1.2,
        "tickSize": 5,
        "ticks": false
