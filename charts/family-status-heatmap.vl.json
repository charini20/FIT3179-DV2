  "encoding": {
    "x": {
      "field": "status_label",
      "type": "ordinal",
      "sort": [
        "Critical",
        "Endangered",
        "Vulnerable",
        "Extinct"
      ],
      "axis": {
        "title": null,
        "orient": "top",
        "labelAngle": 0,
        "labelPadding": 9,
        "labelColor": "#445675",
        "labelFontSize": 10.5,
        "labelFontWeight": 700,
        "labelLimit": 94,
        "domain": false,
        "ticks": false,
        "labelExpr": "datum.label === 'Critical' ? ['Critically','endangered'] : datum.label",
        "labelLineHeight": 11
      }
    },
    "y": {
      "field": "common_family",
      "type": "ordinal",
      "sort": [
        "Rodents",
        "Kangaroos / wallabies",
        "Quolls / dunnarts",
        "Potoroos / bettongs",
        "Bandicoots"
      ],
      "axis": {
        "title": null,
        "labelPadding": 9,
        "labelColor": "#24375C",
        "labelFontSize": 10.6,
        "labelFontWeight": 700,
        "labelLimit": 185,
        "domain": false,
        "ticks": false,
        "labelExpr": "datum.label === 'Kangaroos / wallabies' ? ['Kangaroos', '/ wallabies'] : datum.label === 'Potoroos / bettongs' ? ['Potoroos', '/ bettongs'] : datum.label",
        "labelLineHeight": 13
      }
    },
    "tooltip": [
      {
        "field": "family",
        "type": "nominal",
        "title": "Family"
      },
      {
        "field": "status",
        "type": "nominal",
        "title": "Conservation category"
      },
      {
        "field": "count",
        "type": "quantitative",
        "title": "Listed entries",
        "format": ".0f"
      },
      {
        "field": "total",
        "type": "quantitative",
        "title": "Family entries",
        "format": ".0f"
      },
      {
        "field": "percentage",
        "type": "quantitative",
        "title": "Share within family",
        "format": ".1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 0,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.7
      },
      "encoding": {
        "color": {
          "field": "percentage",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              55
            ],
            "range": [
              "#EDF3FD",
              "#B9CDEA",
              "#7695CC",
              "#375A9C"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontSize": 12,
        "fontWeight": 700,
        "baseline": "middle"
      },
      "encoding": {
        "text": {
          "field": "share_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.percentage >= 34",
            "value": "#FFFFFF"
          },
          "value": "#263C60"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.common_family === 'Bandicoots' && datum.status === 'Extinct'"
        }
      ],
      "mark": {
        "type": "rect",
        "fillOpacity": 0,
        "stroke": "#C1789B",
        "strokeWidth": 3,
        "cornerRadius": 0
      },
      "encoding": {}
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "DM Sans"
  },
  "autosize": {
    "type": "pad",
    "contains": "padding"
  }
}